# Example workspace override file — see workspaces/README.md
#
# Copy this to workspaces/<name>/site.env and fill in real values for that specific site. Only
# include keys that differ from .env.example's defaults; a workspace file is meant to be small.
# Never commit the copy — workspaces/<name>/site.env is gitignored via the repo's *.env rule.

# The identity of this specific site/deployment:
LOCAL_AI_DOMAIN=ai.yourdomain.com
WEBUI_NAME=Your Site Name Here

# Only needed if this site's persistent data should live somewhere other than the repo default —
# when deployed via a deployer (e.g. ../synology-site-deployer), the deployer usually provides
# this instead of you setting it here.
# LOCAL_AI_BASE_PATH=/path/managed/by/deployer/local-ai

# Only needed if this site's exposure posture differs from the LAN-only default:
# DEPLOY_MODE=public_behind_access
# PUBLIC_EXPOSURE=true
