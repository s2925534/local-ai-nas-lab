# Sample .env — portable local mode (future — see docs/portable-local-mode.md)
#
# Portable mode itself (start/stop scripts, auto browser launch) is not implemented yet. This file
# shows the intended configuration shape so it's ready when that work happens. Using it today still
# works as a plain localhost-only Docker Compose config via scripts/bootstrap-local-ai.sh — you'd
# just be starting/stopping manually instead of via a future `start`/`stop` script.

LOCAL_AI_DOMAIN=ai.example.com
LOCAL_AI_BASE_PATH=./data/portable-local-ai

OPEN_WEBUI_PORT=3000
OPEN_WEBUI_BIND_HOST=127.0.0.1

OLLAMA_PORT=11434
OLLAMA_BIND_HOST=127.0.0.1

WEBUI_NAME=Local AI NAS (portable)
ENABLE_SIGNUP=false

DEPLOY_MODE=lan_only
PUBLIC_EXPOSURE=false

REVERSE_PROXY_PROVIDER=none
CLOUDFLARE_TUNNEL_ENABLED=false
TAILSCALE_ADMIN_ACCESS=false

MODEL_GENERAL_SMALL=llama3.2:3b
MODEL_GENERAL_MEDIUM=qwen2.5:7b
MODEL_CODING=qwen2.5-coder:7b
MODEL_EMBEDDING=nomic-embed-text

AUTO_PULL_MODELS=true
AUTO_PULL_MODELS_ON_BOOTSTRAP=true

PORTABLE_MODE=true
PORTABLE_DATA_PATH=./data/portable-local-ai
PORTABLE_OPEN_BROWSER=true
PORTABLE_USE_LOCALHOST_ONLY=true
