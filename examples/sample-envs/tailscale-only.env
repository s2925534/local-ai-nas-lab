# Sample .env — Tailscale-only private access
#
# Same as LAN-only, except you'd bind Open WebUI to localhost/Tailscale interface only and rely on
# Tailscale for remote access instead of exposing it to the whole LAN. This repo does not install
# or configure Tailscale — install it via Synology Package Center (or your OS) separately, then
# reach Open WebUI over the Tailscale network (e.g. http://<tailscale-ip>:3000).
#
# Note: Docker's default port publishing binds to a host interface, not to a specific Tailscale
# interface by name. Binding to 127.0.0.1 and reaching it via `tailscale serve`/Tailscale Funnel,
# or binding to the host's Tailscale IP directly (OPEN_WEBUI_BIND_HOST=100.x.y.z), are the two
# practical options — pick based on your Tailscale setup.

LOCAL_AI_DOMAIN=ai.example.com
LOCAL_AI_BASE_PATH=./data/local-ai

OPEN_WEBUI_PORT=3000
OPEN_WEBUI_BIND_HOST=127.0.0.1

OLLAMA_PORT=11434
OLLAMA_BIND_HOST=127.0.0.1

WEBUI_NAME=Local AI NAS
ENABLE_SIGNUP=false

DEPLOY_MODE=tailscale_only
PUBLIC_EXPOSURE=false

REVERSE_PROXY_PROVIDER=deployer_managed
CLOUDFLARE_TUNNEL_ENABLED=false
TAILSCALE_ADMIN_ACCESS=true

MODEL_GENERAL_SMALL=llama3.2:3b
MODEL_GENERAL_MEDIUM=qwen2.5:7b
MODEL_CODING=qwen2.5-coder:7b
MODEL_EMBEDDING=nomic-embed-text

AUTO_PULL_MODELS=true
AUTO_PULL_MODELS_ON_BOOTSTRAP=true

PORTABLE_MODE=false
