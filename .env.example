# Local AI NAS Lab — environment configuration
#
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# Safe defaults below are LAN-only and use a portable local data path. Nothing here requires a
# Synology volume path such as /volume1 — see docs/portable-local-mode.md and
# docs/deployer-integration.md for why LOCAL_AI_BASE_PATH is left generic.

# --- Domain (informational only — no Cloudflare/DNS automation happens in this repo) ---
# Cloudflare, DNS, tunnels, certificates, and reverse-proxy routing are handled entirely by the
# separate ../synology-site-deployer project. See docs/reverse-proxy-domain.md.
LOCAL_AI_DOMAIN=ai.example.com

# --- Persistent storage ---
# Every persistent folder (models, chat data, documents, prompts, exports, backups, logs, memory)
# lives under this single path. When running manually, point this at any folder you control. When
# deployed via ../synology-site-deployer, the deployer decides and provides this value — this repo
# does not need to know which NAS volume is used. See docs/deployer-integration.md.
LOCAL_AI_BASE_PATH=./data/local-ai

# --- Open WebUI ---
# Open WebUI is the only service meant to ever be reachable beyond localhost. Default binds to all
# interfaces on the LAN; change to 127.0.0.1 for a fully local-only instance.
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_BIND_HOST=0.0.0.0
WEBUI_NAME=Local AI NAS
ENABLE_SIGNUP=false

# --- Ollama ---
# Ollama must never be exposed publicly. Keep OLLAMA_BIND_HOST at 127.0.0.1 unless you fully
# understand the risk of an unauthenticated inference/model-management API being reachable.
OLLAMA_PORT=11434
OLLAMA_BIND_HOST=127.0.0.1

# --- Deployment mode (informational, used by docs/scripts for messaging) ---
# lan_only | tailscale_only | public_behind_access
DEPLOY_MODE=lan_only
PUBLIC_EXPOSURE=false

# --- Reverse proxy / tunnel (informational only, no automation here) ---
# Cloudflare/DNS/tunnel/reverse-proxy setup is owned by ../synology-site-deployer. See
# docs/deployer-integration.md and docs/reverse-proxy-domain.md.
REVERSE_PROXY_PROVIDER=deployer_managed
CLOUDFLARE_TUNNEL_ENABLED=false
TAILSCALE_ADMIN_ACCESS=true

# --- Default models (MVP-friendly sizes only — see docs/future-flags.md ENABLE_LARGE_MODELS) ---
MODEL_GENERAL_SMALL=llama3.2:3b
MODEL_GENERAL_MEDIUM=qwen2.5:7b
MODEL_CODING=qwen2.5-coder:7b
MODEL_EMBEDDING=nomic-embed-text

AUTO_PULL_MODELS=true
AUTO_PULL_MODELS_ON_BOOTSTRAP=true

# --- Portable local mode (future — see docs/portable-local-mode.md, not implemented in MVP) ---
PORTABLE_MODE=false
PORTABLE_DATA_PATH=./data/portable-local-ai
PORTABLE_OPEN_BROWSER=true
PORTABLE_USE_LOCALHOST_ONLY=true

# --- Learning / feedback / personal model (future — see docs/learning-and-self-improvement.md,
# docs/future-flags.md — none of these are implemented in the MVP; all default to false) ---
ENABLE_FEEDBACK_LEARNING_LOOP=false
ENABLE_LOCAL_MEMORY_STORE=false
ENABLE_PROMPT_OPTIMIZER=false
ENABLE_EVALUATION_HARNESS=false
ENABLE_FINE_TUNING_EXPERIMENTS=false
ENABLE_PERSONAL_MODEL_PATH=false
ENABLE_MODEL_DISTILLATION_EXPERIMENTS=false

# --- Examples of other configurations (commented out) ---
#
# Public hostname, exposure managed entirely by ../synology-site-deployer:
# LOCAL_AI_DOMAIN=ai.veloso.dev
# LOCAL_AI_BASE_PATH=/path/managed/by/deployer/local-ai
# DEPLOY_MODE=public_behind_access
# PUBLIC_EXPOSURE=true
# REVERSE_PROXY_PROVIDER=deployer_managed
